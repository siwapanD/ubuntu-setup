# Cloudflare credentials
# Created/updated by setup-cloudflare.sh after entering the values.
# API Token permissions: Account > Cloudflare Tunnel > Edit,
# Zone > Zone > Read, and Zone > DNS > Read + Edit.
CF_ACCOUNT_ID=xxxxxxxx
CF_API_TOKEN=xxxxxxxx
CF_BASE_DOMAIN=example.com
CF_TUNNEL_NAME=my-server

# Portainer
PT_URL=http://localhost:9000
PT_USER=admin
PT_PASS=your_password